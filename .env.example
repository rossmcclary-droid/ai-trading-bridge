# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADING_BRIDGE_SECRET=REPLACE_WITH_FERNET_KEY
TRADING_BRIDGE_DB=trading_bridge.db
PORT=8080

# Real broker orders are blocked unless this is true.
TRADING_EXECUTION_ENABLED=false

# Even when general execution is enabled, LIVE accounts remain blocked unless this is also true.
TRADING_LIVE_EXECUTION_ENABLED=false

# API strategy brain bootstrapped from the exported ChatGPT trading conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
