        "decision": decision,
        "reason": reason,
        "geometry": geometry,
        "execution_context": execution_context,
        "trade_plan": trade_plan,
        "timeframes": analyses,
    }


def evaluate_5m_execution(
    payload: dict[str, Any],
    *,
    bias: str,
) -> dict[str, Any]:
    """Evaluate conservative 5M execution confirmation."""

    bars = normalize_bars(payload)

    if bias not in {"bullish", "bearish"}:
        return {
            "confirmed": False,
            "structure_shift": False,
            "rsi_confirmed": False,
            "candle_confirmed": False,
            "reason": "No directional bias is established.",
        }

    if len(bars) < 20:
        return {
            "confirmed": False,
            "structure_shift": False,
            "rsi_confirmed": False,
            "candle_confirmed": False,
            "reason": "Insufficient 5M candle history.",
        }

    rsi = calculate_rsi(bars)

    recent = bars[-6:]
    current = recent[-1]
    previous = recent[-2]

    prior_high = max(bar["high"] for bar in recent[:-1])
    prior_low = min(bar["low"] for bar in recent[:-1])

    if bias == "bullish":
        structure_shift = (
            current["close"] > previous["high"]
            or current["close"] > prior_high
        )

        rsi_confirmed = (
            rsi is not None
            and rsi >= 50
        )

        candle_confirmed = (
            current["close"] > current["open"]
            and current["close"] >= previous["close"]
        )

    else:
        structure_shift = (
            current["close"] < previous["low"]
            or current["close"] < prior_low
        )

        rsi_confirmed = (
            rsi is not None
            and rsi <= 50
        )

        candle_confirmed = (
            current["close"] < current["open"]
            and current["close"] <= previous["close"]
        )

    confirmed = (
        structure_shift
        and rsi_confirmed
        and candle_confirmed
    )

    if confirmed:
        reason = "5M structure, RSI and candle confirmation agree."
    elif structure_shift:
        reason = "5M structure shifted, but momentum/candle confirmation is incomplete."
    elif rsi_confirmed and candle_confirmed:
        reason = "5M momentum is aligned, but a structural trigger is still missing."
    else:
        reason = "5M execution confirmation is incomplete."

    return {
        "confirmed": confirmed,
        "structure_shift": structure_shift,
        "rsi_confirmed": rsi_confirmed,
        "candle_confirmed": candle_confirmed,
        "rsi_14": round(rsi, 2) if rsi is not None else None,
        "reason": reason,
    }


def analyze_scan(
    scan: dict[str, Any],
) -> dict[str, Any]:
    """Bootstrap v2 analysis with executable B+ gating."""

    analyses: dict[str, Any] = {}

    for timeframe, payload in scan["timeframes"].items():
        analyses[timeframe] = analyze_timeframe(payload)

    state, bias = classify_multi_horizon_state(analyses)

    geometry = evaluate_trade_geometry(
        scan["timeframes"]["15M"],
        bias=bias,
    )

    execution_context = analyze_execution_context(
        scan["timeframes"]["15M"]
    )

    trade_plan = derive_trade_plan(
        scan,
        bias=bias,
    )

    execution_5m = evaluate_5m_execution(
        scan["timeframes"]["5M"],
        bias=bias,
    )

    grade = "WATCH"
    decision = "WATCH"

    if state == "conflicted":
        grade = "REJECT"
        decision = "REJECT"
        reason = (
            "Directional evidence is materially conflicted and lacks "
            "sufficient edge."
        )

    elif state == "transitioning" and bias == "neutral":
        reason = (
            "4H and 1H directional structure disagree; possible deeper "
            "correction or structural transition. Wait for 15M/5M clarity."
        )

    elif state == "pulling_back":
        reason = (
            "Higher-horizon bias remains intact while lower horizons pull "
            "back. Wait for momentum reconvergence."
        )

    elif (
        bias in {"bullish", "bearish"}
        and state in {"aligned", "reconverging"}
        and trade_plan["valid"]
        and execution_5m["confirmed"]
        and execution_context["extension"] == "normal"
        and geometry["entry_quality"] in {"efficient", "acceptable"}
    ):
        grade = "B+"
        decision = "APPROVED ACTIVE TRADE"
        reason = (
            "Directional state, structural geometry and 5M execution "
            "confirmation satisfy the minimum executable threshold."
        )

    elif state == "reconverging":
        decision = "ALERT ONLY"

        if not trade_plan["valid"]:
            reason = (
                "Momentum reconvergence is developing, but structural "
                "reward-to-risk is not yet sufficient."
            )
        elif not execution_5m["confirmed"]:
            reason = (
                "Momentum reconvergence is developing and geometry is viable, "
                "but the 5M execution trigger is incomplete."
            )
        else:
            reason = (
                "Momentum reconvergence is developing, but the setup has not "
                "met all executable requirements."
            )

    elif state == "aligned":
        if execution_context["extension"] in {
            "extended",
            "highly_extended",
        }:
            reason = (
                "Trend valid but entry is extended relative to recent "
                "volatility. Wait for a reset."
            )

        elif geometry["entry_quality"] == "late":
            reason = (
                "Directional alignment is present, but entry location is late."
            )

        elif not trade_plan["valid"]:
            reason = (
                "Directional alignment is present, but structural "
                "reward-to-risk is insufficient."
            )

        elif not execution_5m["confirmed"]:
            decision = "ALERT ONLY"
            reason = (
                "Directional alignment and trade geometry are viable, but "
                "the 5M execution trigger is incomplete."
            )

        else:
            reason = (
                "The setup has not met every executable requirement."
            )

    else:
        reason = (
            "The setup has not earned approval under current "
            "multi-horizon evidence."
        )

    return {
        "symbol": scan["symbol"],
        "directional_bias": bias,
        "multi_horizon_state": state,
        "setup_grade": grade,
        "decision": decision,
        "reason": reason,
        "geometry": geometry,
        "execution_context": execution_context,
        "trade_plan": trade_plan,
        "execution_5m": execution_5m,
        "timeframes": analyses,
    }


def derive_alert_level(
    scan: dict[str, Any],
    *,
    bias: str,
    state: str,
) -> dict[str, Any]:
    """Derive a conservative price level for reassessment."""

    bars_5m = normalize_bars(scan["timeframes"]["5M"])
    bars_15m = normalize_bars(scan["timeframes"]["15M"])

    if bias not in {"bullish", "bearish"}:
        return {
            "alert_level": None,
            "alert_type": None,
            "meaning": "No directional bias is established.",
        }

    if len(bars_5m) < 6 or len(bars_15m) < 6:
        return {
            "alert_level": None,
            "alert_type": None,
            "meaning": "Insufficient structure for an alert level.",
        }

    recent_5m = bars_5m[-6:]
    recent_15m = bars_15m[-12:]

    if bias == "bullish":
        micro_trigger = max(bar["high"] for bar in recent_5m[:-1])
        setup_trigger = max(bar["high"] for bar in recent_15m[:-1])

        if state == "reconverging":
            return {
                "alert_level": micro_trigger,
                "alert_type": "momentum_reconvergence",
                "meaning": "Bullish 5M reclaim/reconvergence check.",
            }

        return {
            "alert_level": min(micro_trigger, setup_trigger),
            "alert_type": "resistance_break",
            "meaning": "Bullish structure-break reassessment.",
        }

    micro_trigger = min(bar["low"] for bar in recent_5m[:-1])
    setup_trigger = min(bar["low"] for bar in recent_15m[:-1])

    if state == "reconverging":
        return {
            "alert_level": micro_trigger,
            "alert_type": "momentum_reconvergence",
            "meaning": "Bearish 5M breakdown/reconvergence check.",
        }

    return {
        "alert_level": max(micro_trigger, setup_trigger),
        "alert_type": "support_break",
        "meaning": "Bearish structure-break reassessment.",
    }

def derive_alert_levels(
    scan: dict[str, Any],
    *,
    bias: str,
    state: str,
) -> list[dict[str, Any]]:
    """Return distinct, conservative reassessment levels.

    Keeps 5M micro structure and 15M setup structure separate
    when they produce meaningfully different prices.
    """

    bars_5m = normalize_bars(scan["timeframes"]["5M"])
    bars_15m = normalize_bars(scan["timeframes"]["15M"])

    if bias not in {"bullish", "bearish"}:
        return []

    if len(bars_5m) < 6 or len(bars_15m) < 6:
        return []

    recent_5m = bars_5m[-6:]
    recent_15m = bars_15m[-12:]

    if bias == "bullish":
        micro_trigger = max(
            bar["high"] for bar in recent_5m[:-1]
        )
        setup_trigger = max(
            bar["high"] for bar in recent_15m[:-1]
        )

        candidates = [
            {
                "alert_level": micro_trigger,
                "alert_type": "momentum_reconvergence",
                "meaning": (
                    "Bullish 5M reclaim/reconvergence check."
                ),
            },
            {
                "alert_level": setup_trigger,
                "alert_type": "resistance_break",
                "meaning": (
                    "Bullish 15M structure-break reassessment."
                ),
            },
        ]

    else:
        micro_trigger = min(
            bar["low"] for bar in recent_5m[:-1]
        )
        setup_trigger = min(
            bar["low"] for bar in recent_15m[:-1]
        )

        candidates = [
            {
                "alert_level": micro_trigger,
                "alert_type": "momentum_reconvergence",
                "meaning": (
                    "Bearish 5M breakdown/reconvergence check."
                ),
            },
            {
                "alert_level": setup_trigger,
                "alert_type": "support_break",
                "meaning": (
                    "Bearish 15M structure-break reassessment."
                ),
            },
        ]

    # Remove duplicate levels while preserving priority.
    unique: list[dict[str, Any]] = []
    seen_levels: set[float] = set()

    for candidate in candidates:
        level = candidate["alert_level"]

        if level is None:
            continue

        normalized = round(float(level), 10)

        if normalized in seen_levels:
            continue

        seen_levels.add(normalized)
        unique.append(candidate)

    return unique


