    )

    execution_context = analyze_execution_context(
        scan["timeframes"]["15M"]
    )

    trade_plan = derive_trade_plan(
        scan,
        bias=bias,
    )

    grade = "WATCH"
    decision = "WATCH"

    if state == "conflicted":
        grade = "REJECT"
        decision = "REJECT"
        reason = (
            "Directional evidence is materially conflicted and lacks "
            "sufficient edge."
        )

    elif state == "transitioning" and bias == "neutral":
        reason = (
            "4H and 1H directional structure disagree; possible deeper "
            "correction or structural transition. Wait for 15M/5M clarity."
        )

    elif state == "pulling_back":
        reason = (
            "Higher-horizon bias remains intact while lower horizons pull "
            "back. Wait for momentum reconvergence."
        )

    elif state == "reconverging":
        decision = "ALERT ONLY"

        if not trade_plan["valid"]:
            reason = (
                "Momentum reconvergence is developing, but structural "
                "reward-to-risk is not yet sufficient."
            )
        else:
            reason = (
                "Momentum reconvergence and structural geometry are "
                "developing. Execution confirmation is still required."
            )

    elif state == "aligned":
        extension = execution_context["extension"]
