                  `${instrument} setup is ready for approval.`,
                );
              }
            });
          }
        }
      }
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Unable to run scan."
      );
    } finally {
      setLoading(false);
    }
  }

