  useEffect(() => {
    let cancelled = false;

    async function refreshMonitorStatus() {
      try {
        const response = await fetch("/api/monitor/status");

        if (!response.ok) {
          throw new Error(`Monitor status failed: HTTP ${response.status}`);
        }

        const status = await response.json();

        if (!cancelled) {
          setMonitorStatus(status);

          if (status.latest_result) {
            setData(status.latest_result);
            setLastScan(
              status.last_scan_at
                ? new Date(status.last_scan_at).toLocaleTimeString()
                : new Date().toLocaleTimeString()
            );
          }
        }
      } catch {
        // Keep the last known status if the monitor endpoint
        // is briefly unavailable.
      }
    }

    void refreshMonitorStatus();

    const timer = window.setInterval(() => {
      void refreshMonitorStatus();
    }, 5000);

    return () => {
      cancelled = true;
      window.clearInterval(timer);
    };
  }, []);

  async function submitApprovalAction(
    action: string,
    instrument: string,
    account: string | null = "Challenge",
    trade?: {
      direction: "LONG" | "SHORT";
      entry: number;
      safe_loss: number;
      take_profit_1: number;
      take_profit_2: number;
    },
  ) {
    setApprovalMessage("Sending approval decision...");

    try {
      const response = await fetch("/api/approvals", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          action,
          instrument,
          account,
          ...(trade ?? {}),
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result?.detail ?? `HTTP ${response.status}`);
      }

      const parts = [
        result.message ?? "Decision recorded.",
        `Action: ${result.action}`,
        `Execution: ${result.execution_status}`,
      ];

      if (result.explanation_requested) {
        parts.push("Explanation requested.");
      }

      if (result.all_accounts) {
        parts.push("Scope: all connected accounts.");
      }

      if (result.execution_preview) {
        const p = result.execution_preview;

        parts.push(
          `DRY RUN: ${p.side} ${p.instrument} | Entry ${p.entry} | Safe Loss ${p.safe_loss} | TP1 ${p.take_profit_1} | TP2 ${p.take_profit_2}.`,
        );
      }

      if (result.validation_error) {
        parts.push(`BLOCKED: ${result.validation_error}`);
      }

      setApprovalMessage(parts.join(" "));
    } catch (error) {
      setApprovalMessage(
        `Approval request failed: ${
          error instanceof Error ? error.message : "Unknown error"
        }`,
      );
    }
  }



  async function exportAiScan() {
    setExportingAiScan(true);
    setError("");

    try {
      const response = await fetch(
        "/api/scan/Challenge/export-ai",
      );

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const blob = await response.blob();

      const disposition =
        response.headers.get("Content-Disposition") ?? "";

      const filenameMatch =
        disposition.match(/filename="?([^"]+)"?/i);

      const filename =
        filenameMatch?.[1] ??
        `AI_Scan_Challenge_${new Date()
          .toISOString()
          .replace(/[:.]/g, "-")}.json`;

      const file = new File(
        [blob],
        filename,
        {
            type:
                blob.type ||
                "application/json",
        },
    );

    if (
        typeof navigator.share === "function" &&
        typeof navigator.canShare === "function" &&
        navigator.canShare({ files: [file] })
    ) {
        await navigator.share({
            files: [file],
            title: "Atlas AI Scan",
        });
    } else {
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download = filename;

        document.body.appendChild(link);
        link.click();

        window.setTimeout(() => {
            link.remove();
            URL.revokeObjectURL(url);
        }, 30000);
    }
} catch (err) {
      setError(
        err instanceof Error
          ? `AI Scan export failed: ${err.message}`
          : "AI Scan export failed.",
      );
    } finally {
      setExportingAiScan(false);
    }
  }




  async function showBridgeNotification(
    title: string,
    body: string,
  ) {
    if (!("serviceWorker" in navigator)) {
      setError(
        "Service-worker notifications are not supported in this browser.",
      );
      return;
    }

    if (
      !("Notification" in window) ||
      Notification.permission !== "granted"
    ) {
      return;
    }

    const registration =
      await navigator.serviceWorker.register("/sw.js");

    await navigator.serviceWorker.ready;

    await registration.showNotification(title, {
      body,
      tag: "ai-trading-bridge-trade-alert",
      data: {
        url: "/",
      },
    });
  }


  async function enableNotifications() {
    if (!("Notification" in window)) {
      setError("Notifications are not supported in this browser.");
      return;
    }

    const permission = await Notification.requestPermission();
    setNotificationPermission(permission);

    if (permission === "granted") {
      setNotificationPermission("granted");
    }
  }




  async function refreshBootstrapStatus() {
    try {
