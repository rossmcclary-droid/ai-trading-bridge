      setBootstrapStatus(result);
    } catch (err) {
      setBootstrapMessage(
        err instanceof Error
          ? `Bootstrap status failed: ${err.message}`
          : "Unable to read Bootstrap status.",
      );
    }
  }

  async function reviewBootstrapFile(file: File) {
    setBootstrapBusy(true);
    setBootstrapMessage("");

    try {
      const content = await file.text();

      if (!content.trim()) {
        throw new Error("Bootstrap file is empty.");
      }

      const requiredSections = [
        "PART I — HUMAN-READABLE STRATEGY",
        "PART II — MACHINE-READABLE BOOTSTRAP",
      ];

      for (const section of requiredSections) {
        if (!content.includes(section)) {
          throw new Error(
            `Revision is missing required section: ${section}`,
          );
        }
      }

      const bytes = new TextEncoder().encode(content);
      const digest = await crypto.subtle.digest("SHA-256", bytes);

      const fingerprint = Array.from(
        new Uint8Array(digest),
      )
        .map((byte) => byte.toString(16).padStart(2, "0"))
        .join("");

      setPendingBootstrap({
        file,
        content,
        fingerprint,
      });

      setBootstrapMessage("");
    } catch (err) {
      setPendingBootstrap(null);

      setBootstrapMessage(
        err instanceof Error
          ? `Bootstrap review blocked: ${err.message}`
          : "Unable to review Bootstrap revision.",
      );
    } finally {
      setBootstrapBusy(false);
    }
  }

  async function confirmBootstrapInstall() {
    if (!pendingBootstrap) return;

    setBootstrapBusy(true);
    setBootstrapMessage("");

    try {
      const response = await fetch("/api/bootstrap/install", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          content: pendingBootstrap.content,
          source_name: pendingBootstrap.file.name,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          result?.detail ?? `HTTP ${response.status}`,
        );
      }

      setBootstrapStatus(result);
      setPendingBootstrap(null);

      setBootstrapMessage(
        "Revision installed safely. Restart backend to activate it.",
      );
    } catch (err) {
      setBootstrapMessage(
        err instanceof Error
          ? `Bootstrap update blocked: ${err.message}`
          : "Bootstrap update failed.",
      );
    } finally {
      setBootstrapBusy(false);
    }
  }


  async function rollbackBootstrap() {
    if (!bootstrapStatus?.previous_available) {
      setBootstrapMessage(
        "No previous Bootstrap revision is available.",
      );
      return;
    }

    setBootstrapBusy(true);
    setBootstrapMessage("");

    try {
      const response = await fetch(
        "/api/bootstrap/rollback",
        {
          method: "POST",
        },
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          result?.detail ?? `HTTP ${response.status}`,
        );
      }

      setBootstrapStatus(result);
      setBootstrapMessage(
        "Previous Bootstrap restored. Restart backend to activate it.",
      );
    } catch (err) {
      setBootstrapMessage(
        err instanceof Error
          ? `Rollback failed: ${err.message}`
          : "Bootstrap rollback failed.",
      );
    } finally {
      setBootstrapBusy(false);
    }
  }



  useEffect(() => {
