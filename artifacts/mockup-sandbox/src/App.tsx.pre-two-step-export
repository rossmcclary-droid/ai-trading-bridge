            {data.top_candidate && (
              <Card title="QUALIFICATION PROGRESS">
                <div
                  style={{
                    display: "grid",
                    gap: 12,
                  }}
                >
                  {[
                    {
                      label: "Entry quality",
                      value: data.top_candidate.entry_quality,
                      passed:
                        data.top_candidate.entry_quality === "efficient" ||
                        data.top_candidate.entry_quality === "acceptable",
                    },
                    {
                      label: "TP1 R:R",
                      value:
                        data.top_candidate.rr_tp1 == null
                          ? "—"
                          : `${data.top_candidate.rr_tp1} / 0.75`,
                      passed:
                        data.top_candidate.rr_tp1 != null &&
                        data.top_candidate.rr_tp1 >= 0.75,
                    },
                    {
                      label: "TP2 R:R",
                      value:
                        data.top_candidate.rr_tp2 == null
                          ? "—"
                          : `${data.top_candidate.rr_tp2} / 1.50`,
                      passed:
                        data.top_candidate.rr_tp2 != null &&
                        data.top_candidate.rr_tp2 >= 1.5,
                    },
                    {
                      label: "5M confirmation",
                      value: data.top_candidate["5m_confirmed"]
                        ? "Confirmed"
                        : "Missing",
                      passed: data.top_candidate["5m_confirmed"],
                    },
                    {
                      label: "Extension",
                      value: data.top_candidate.extension,
                      passed:
                        data.top_candidate.extension !== "extended" &&
                        data.top_candidate.extension !== "highly_extended",
                    },
                    {
                      label: "Multi-horizon state",
                      value: data.top_candidate.state,
                      passed: data.top_candidate.state !== "transitioning",
                    },
                  ].map((item) => (
                    <div
                      key={item.label}
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        alignItems: "center",
                        gap: 14,
                        padding: "11px 12px",
                        borderRadius: 12,
                        background: "#101010",
                        border: "1px solid #2b2b2b",
                      }}
                    >
                      <div>
                        <div
                          style={{
                            color: "#8d8d8d",
                            fontSize: 11,
                            textTransform: "uppercase",
                            letterSpacing: 0.7,
                          }}
                        >
                          {item.label}
                        </div>

                        <div
                          style={{
                            marginTop: 4,
                            fontWeight: 700,
                            fontSize: 15,
                          }}
                        >
                          {item.value}
                        </div>
                      </div>

                      <div
                        style={{
                          minWidth: 30,
                          textAlign: "center",
                          fontSize: 18,
                          fontWeight: 800,
                          color: item.passed ? "#8fe0a5" : "#e7a1a1",
                        }}
                      >
                        {item.passed ? "✓" : "○"}
                      </div>
                    </div>
                  ))}
                </div>

                <div
                  style={{
                    marginTop: 12,
                    color: "#777",
                    fontSize: 12,
                    lineHeight: 1.45,
                  }}
                >
                  Progress is informational only. Trade approval still requires
                  the full backend strategy gate.
                </div>
              </Card>
            )}

            <Card title="EXECUTABLE ORDERS">
              {data.executable_orders.length === 0 ? (
                <div>
                  <div
                    style={{
                      fontSize: 20,
                      fontWeight: 700,
                    }}
                  >
                    No trade yet.
                  </div>
                  <div
                    style={{
                      color: "#8d8d8d",
                      marginTop: 6,
                    }}
                  >
                    No setup currently meets the executable threshold.
                  </div>
                </div>
              ) : (
                <div style={{ display: "grid", gap: 12 }}>
                  {data.executable_orders.map((order) => (
                    <div
                      key={order.instrument}
                      style={{
                        border: "1px solid #275a36",
                        background: "#102517",
                        borderRadius: 14,
                        padding: 15,
                      }}
                    >
                      <div
                        style={{
                          fontSize: 20,
                          fontWeight: 800,
                          marginBottom: 10,
                        }}
                      >
                        {order.instrument}
                      </div>

                <div
                  style={{
                    color: "#8fe0a5",
                    fontSize: 12,
                    fontWeight: 800,
                    marginBottom: 8,
                  }}
                >
                  {order.order_type}
                </div>

                      <div>Entry: {order.entry}</div>
                      <div>Safe Loss: {order.safe_loss}</div>
                      <div>Take Profit 1: {order.take_profit_1}</div>
                      <div>Take Profit 3: {order.take_profit_3}</div>
                      <div>Take Profit 2: {order.take_profit_2}</div>

                <div
                  style={{
                    marginTop: 14,
                    paddingTop: 14,
                    borderTop: "1px solid #275a36",
                  }}
                >
                  <div
                    style={{
                      fontSize: 12,
                      fontWeight: 800,
                      color: "#8fe0a5",
                      marginBottom: 10,
                    }}
                  >
                    APPROVAL REQUIRED
                  </div>

                  <div
                    style={{
                      display: "grid",
                      gridTemplateColumns: "1fr 1fr",
                      gap: 8,
                    }}
                  >
                    {[
                      ["App", "Approve trade"],
                      ["App + Exp", "Approve and explain trade"],
                      ["Exp", "Explain trade"],
                      ["Rej", "Reject trade"],
                      ["App All", "Approve across all connected accounts"],
                    ].map(([label, title]) => (
                      <button
                        key={label}
                        type="button"
                        title={title}
                        onClick={() => {
                          void submitApprovalAction(
                            label,
                            order.instrument,
                            "Challenge",
                          );
                        }}
                        style={{
                          minHeight: 42,
                          borderRadius: 10,
                          border: "1px solid #3b3b3b",
                          background: "#181818",
                          color: "#f5f5f5",
                          fontWeight: 800,
                          fontSize: 12,
                          padding: "8px 10px",
                        }}
                      >
                        {label}
                      </button>
                    ))}
                  </div>

                  <div
                    style={{
                      marginTop: 9,
                      color: "#8d8d8d",
                      fontSize: 11,
                      lineHeight: 1.4,
                    }}
                  >
                    Approval controls are currently UI-only. No trade is sent
                    by these buttons yet.
                  </div>
                </div>
                    </div>
                  ))}
                </div>
              )}
            </Card>

            <Card title={`ALERTS · ${data.alerts.length}`}>
        <details>
          <summary
            style={{
              cursor: "pointer",
              border: "1px solid #303030",
              borderRadius: 12,
              padding: "12px 14px",
              background: "#141414",
              color: "#c7c7c7",
              fontSize: 14,
              fontWeight: 800,
              listStyle: "none",
            }}
          >
            Show Alert Details
          </summary>

          <div style={{ marginTop: 12 }}>

              {data.alerts.length === 0 ? (
                <div style={{ color: "#999" }}>No active alerts.</div>
              ) : (
                <div style={{ display: "grid", gap: 12 }}>
                  {data.alerts.map((alert) => (
                    <div
                      key={`${alert.instrument}-${alert.alert_level}`}
                      style={{
                        border: "1px solid #303030",
                        borderRadius: 14,
                        padding: 15,
                        background: "#101010",
                      }}
                    >
                      <div
                        style={{
                          display: "flex",
                          justifyContent: "space-between",
                          alignItems: "center",
                          gap: 10,
                        }}
                      >
                        <div
                          style={{
                            fontSize: 20,
                            fontWeight: 800,
                          }}
                        >
                          {alert.instrument}
                        </div>

                        <BiasBadge bias={alert.bias} />
                      </div>

                      <div
                        style={{
                          fontSize: 27,
                          fontWeight: 800,
                          marginTop: 12,
                        }}
                      >
                        {alert.alert_level}
                      </div>

                      <div
                        style={{
                          color: "#aaa",
                          marginTop: 6,
                          lineHeight: 1.45,
                        }}
                      >
                        {alert.meaning}
                      </div>

                      <div
                        style={{
                          marginTop: 10,
                          color: "#727272",
                          fontSize: 12,
                        }}
                      >
                        {alert.state} · {alert.grade}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            
          </div>
        </details>
      </Card>

            <Card title={`WATCHLIST · ${data.watchlist.length}`}>
        <details>
          <summary
            style={{
              cursor: "pointer",
              border: "1px solid #303030",
              borderRadius: 12,
              padding: "12px 14px",
              background: "#141414",
              color: "#c7c7c7",
              fontSize: 14,
              fontWeight: 800,
              listStyle: "none",
            }}
          >
            Show Watchlist Details
          </summary>

          <div style={{ marginTop: 12 }}>

              {data.watchlist.length === 0 ? (
                <div style={{ color: "#999" }}>
                  No additional markets waiting for confirmation.
                </div>
              ) : (
                <div style={{ display: "grid", gap: 12 }}>
                  {data.watchlist.map((item) => (
                    <div
                      key={item.instrument}
                      style={{
                        border: "1px solid #303030",
                        borderRadius: 14,
                        padding: 15,
                        background: "#101010",
                      }}
                    >
                      <div
                        style={{
                          display: "flex",
                          alignItems: "center",
                          justifyContent: "space-between",
                          gap: 10,
                        }}
                      >
                        <div
                          style={{
                            fontSize: 20,
                            fontWeight: 800,
                          }}
                        >
                          {item.instrument}
                        </div>

                        <BiasBadge bias={item.bias} />
                      </div>

                      <div
                        style={{
                          marginTop: 8,
                          color: "#8d8d8d",
                          fontSize: 13,
                        }}
                      >
                        {item.state} · {item.decision}
                      </div>

                      <div
                        style={{
                          marginTop: 10,
                          color: "#c7c7c7",
                          lineHeight: 1.5,
                        }}
                      >
                        {item.reason}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            
          </div>
        </details>
      </Card>
          </>
        )}
      </div>
    </main>
  );
}
