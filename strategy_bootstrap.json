{
  "strategy_name": "AI Trading Bridge Strategy Bootstrap v1",
  "version": "1.0",
  "primary_goal": "Identify, rank, confirm, propose, and manage only clean trading setups using multi-timeframe market structure, key levels, RSI, volume, confirmation, and account-aware risk.",
  "operating_style": {"selectivity":"high","default_when_uncertain":"NO_TRADE","confirmation_over_prediction":true,"chasing_allowed":false,"alerts_are_entries":false,"structure_priority":"high"},
  "timeframes": {
    "4H":{"role":"macro_context","evaluate":["dominant_trend","major_support","major_resistance","major_breakout_zones","price_extension","range_vs_trend","major_structural_highs","major_structural_lows"]},
    "1H":{"role":"direction_and_structure","evaluate":["trend_direction","higher_highs","higher_lows","lower_highs","lower_lows","breakouts","reclaims","room_to_next_major_level"]},
    "15M":{"role":"setup_confirmation","evaluate":["candle_close_through_key_level","breakout_acceptance","support_loss","resistance_reclaim","momentum","RSI","volume"]},
    "5M":{"role":"trigger_and_execution","evaluate":["continuation","rejection","retest","failed_reclaim","higher_high","higher_low","lower_high","lower_low","RSI_reaction","entry_quality"]}
  },
  "market_structure":{"HH":"swing high above the previous relevant swing high","HL":"swing low above the previous relevant swing low","LH":"swing high below the previous relevant swing high","LL":"swing low below the previous relevant swing low","bullish_sequence":["HH","HL","HH"],"bearish_sequence":["LL","LH","LL"],"candle_color_is_not_structure":true},
  "key_level_rules":{"touch_is_confirmation":false,"wick_through_is_confirmation":false,"close_through_is_stronger_confirmation":true,"preferred_confirmation_sequence":["touch","close_through","retest_or_follow_through","structure_confirmation"]},
  "breakout_rules":{"requirements":["meaningful_structural_level","body_close_beyond_level_when_close_confirmation_required","supportive_momentum","prefer_supportive_volume","higher_timeframe_alignment_or_non_conflict","room_before_next_major_barrier"],"post_breakout_behavior":["do_not_chase_vertical_move","prefer_retest","prefer_consolidation","prefer_continuation_structure"]},
  "breakdown_rules":{"requirements":["meaningful_support_break","prefer_15M_close_below_support","inspect_5M_after_break","look_for_failed_reclaim","look_for_LH_LL_continuation"]},
  "RSI":{"period":14,"reference_levels":{"overbought":70,"neutral":50,"oversold":30},"standalone_entry_signal":false,"rules":["RSI_above_70_does_not_automatically_mean_short","RSI_below_30_does_not_automatically_mean_long","extreme_RSI_increases_chasing_risk","RSI_recovery_should_be_confirmed_by_price_structure","RSI_divergence_is_supporting_evidence_only"]},
  "volume":{"role":"confirmation","rules":["prefer_expanding_volume_on_breakout","declining_volume_on_orderly_pullback_can_be_constructive","strong_opposing_volume_can_signal_reversal","unfinished_candle_volume_is_not_final","volume_does_not_replace_structure"]},
  "entry":{"long_preferences":["4H_or_1H_bullish_or_non_bearish","resistance_break_or_support_reclaim","15M_confirmation_when_required","5M_HH_HL_or_retest_hold","supportive_RSI","supportive_volume","clear_invalidation","adequate_room_to_target","acceptable_reward_to_risk"],"short_preferences":["4H_or_1H_bearish_or_clear_resistance_failure","support_break","15M_confirmation_when_required","5M_LH_LL_or_failed_reclaim","supportive_bearish_RSI_behavior","supportive_volume","clear_invalidation","adequate_room_to_target","acceptable_reward_to_risk"]},
  "pending_orders":{"allowed":true,"use_when":["entry_level_is_prevalidated","expected_reaction_is_well_defined","invalidation_is_known_in_advance","risk_reward_is_still_good"],"avoid_when":["trade_depends_on_observing_reaction","confirmation_is_still_needed","market_is_highly_extended_or_erratic"],"reaction_required_action":"SET_ALERT_INSTEAD"},
  "alerts":{"purpose":"request_reassessment_at_meaningful_price","not_automatic_entry":true,"good_alert_locations":["major_support","major_resistance","breakout_level","breakdown_level","retest_zone","structural_swing_high","structural_swing_low","thesis_invalidation_level"],"on_trigger":["open_chart","classify_event","check_candle_close","check_structure","check_RSI","check_volume","check_required_timeframe","decide_watch_alert_propose_or_reject"]},
  "stop_loss":{"basis":"structural_invalidation","long_examples":["below_retest_low","below_higher_low","below_reclaimed_support"],"short_examples":["above_lower_high","above_failed_reclaim","above_resistance"],"rules":["do_not_use_arbitrary_stop_without_structure","do_not_widen_stop_to_avoid_loss","allow_normal_market_noise"]},
  "take_profit":{"basis":"market_structure","target_types":["prior_swing_high","prior_swing_low","next_1H_support_resistance","next_4H_support_resistance","range_boundary","technically_justified_measured_move"],"reject_if_nearest_target_produces_poor_reward_to_risk":true},
  "trade_management":{"long_monitor":["HH_HL_continuation","key_level_holds","RSI_momentum","volume"],"short_monitor":["LH_LL_continuation","failed_reclaims","RSI_momentum","volume"],"valid_actions":["HOLD","REDUCE","MOVE_STOP","TAKE_PARTIAL","EXIT","INVALIDATED"],"single_opposing_5M_candle_auto_exit":false},
  "no_trade_conditions":["strong_higher_timeframe_conflict","middle_of_range","ambiguous_structure","severely_extended_breakout","late_entry_after_vertical_move","poor_reward_to_risk","unclear_invalidation","insufficient_room_to_next_level","high_spread_relative_to_stop","extreme_whipsaw","required_candle_not_closed","alert_triggered_without_reaction_confirmation","giant_impulse_candle_without_follow_through","unconfirmed_HH_HL_LH_LL","setup_requires_guessing"],
  "setup_grades":{"A+":"exceptional_multitimeframe_alignment_and_entry_quality","A":"clean_tradeable_setup","B":"watch_or_alert_only","C":"weak","REJECT":"do_not_trade"},
  "top_3_ranking":{"rank_by":["higher_timeframe_alignment","market_structure_clarity","key_level_quality","confirmation_quality","risk_reward","room_to_target","RSI_quality","volume_quality","spread_quality","lack_of_nearby_conflicting_levels","entry_quality","invalidation_clarity"],"rank_by_biggest_percentage_move":false},
  "scan_workflow":["scan_market_list","shortlist_candidates","request_1H_and_15M_as_needed","request_4H_for_macro_context_if_needed","request_5M_for_execution_if_setup_survives","rank_top_3","set_alerts_or_propose_trade"],
  "risk":{"position_size_method":"derive_from_account_risk_and_stop_distance","size_from_margin_available":false,"stop_required_before_entry":true,"correlation_risk_required":true,"crypto_positions_are_potentially_correlated":true,"numeric_risk_limits":{"max_risk_per_trade":null,"max_total_open_risk":null,"max_simultaneous_trades":null,"daily_loss_limit":null},"instruction_when_numeric_limits_missing":"do_not_claim_final_safe_position_size"},
  "account_awareness":{"instrument_specific_contracts":true,"leverage_varies_by_asset_class":true,"observed_examples":{"crypto":"approximately 3x in shown account","forex":"approximately 50x in shown account","selected_indices_or_metals":"approximately 25x in shown account"},"never_compare_risk_by_lot_number_alone":true},
  "correlation":{"evaluate_between_related_assets":true,"examples":["BTC","ETH","BNB","ZEC","other_crypto"],"instruction":"multiple correlated positions must be treated as aggregate directional risk"},
  "decision_states":["NO_TRADE","WATCH","SET_ALERT","PROPOSE","APPROVE","REJECT","MANAGE","EXIT"],
  "proposal_output_required_fields":["instrument","direction","setup_grade","4H_bias","1H_structure","15M_setup","5M_trigger","key_level","RSI","volume","entry","stop_loss","take_profit_1","take_profit_2_optional","risk_reward","invalidation","missing_confirmation_if_any","reasoning"],
  "permanent_AI_behavior":["do_not_force_trades","do_not_fabricate_confidence","do_not_chase","do_not_use_RSI_alone","do_not_treat_alert_as_entry","do_not_confuse_candle_color_with_structure","do_not_ignore_spread","do_not_ignore_correlation","do_not_approve_without_invalidation","request_additional_chart_when_materially_needed","state_missing_confirmation_explicitly","prefer_no_trade_over_low_quality_trade"],
  "explanation_requirements":["direction","current_market_structure","4H_bias","1H_structure","15M_setup","5M_trigger","RSI_condition","volume_condition","key_level","entry_logic","stop_invalidation","targets","reward_to_risk","cancellation_condition","what_would_improve_setup","confidence_or_setup_grade"],
  "core_principle":"The higher timeframes establish the opportunity. The 15M establishes whether the key level has actually changed. The 5M tells us whether the market is giving a clean entry. An alert gets our attention; structure earns the trade."
}
